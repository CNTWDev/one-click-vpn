# Required for a production deployment. one-click-deploy.sh writes NODE_ENV=production.
NODE_ENV=production
APP_DOMAIN=app.example.com
# Independent HTTP surfaces. Use app/console for browsers and api for native clients + Agents.
NORTHSTAR_PORTAL_DOMAIN=app.example.com
NORTHSTAR_ADMIN_DOMAIN=console.example.com
NORTHSTAR_API_DOMAIN=api.example.com
NORTHSTAR_ADMIN_EMAIL=owner@example.com
NORTHSTAR_ADMIN_PASSWORD=replace-with-a-long-random-password
# 32 random bytes, encoded as base64. Generate with: openssl rand -base64 32
NORTHSTAR_MASTER_KEY=replace-with-32-byte-base64-key
NORTHSTAR_PUBLIC_ORIGIN=https://app.example.com
NORTHSTAR_API_ORIGIN=https://api.example.com
NORTHSTAR_AGENT_ORIGIN=https://api.example.com

# Optional Controller map location. If unset, configure it from the Controller page.
NORTHSTAR_CONTROLLER_LOCATION=
NORTHSTAR_CONTROLLER_LATITUDE=
NORTHSTAR_CONTROLLER_LONGITUDE=

# A random password for the PostgreSQL service. The one-click installer generates it.
NORTHSTAR_DB_PASSWORD=replace-with-random-database-password
# Random password for the internal MinIO-backed operational log store.
NORTHSTAR_LOG_STORAGE_PASSWORD=replace-with-random-log-storage-password

# Optional.
NORTHSTAR_ADMIN_NAME=Owner
NORTHSTAR_SESSION_TTL_SECONDS=43200
# Only for local development; never enable this in production.
NORTHSTAR_ALLOW_TOFU_HOST_KEYS=false
