# Required for a production deployment. one-click-deploy.sh writes NODE_ENV=production.
NODE_ENV=production
APP_DOMAIN=app.example.com
# Independent HTTP surfaces. Use app/console for browsers and api for native clients + Agents.
VEILBIRD_PORTAL_DOMAIN=app.example.com
VEILBIRD_ADMIN_DOMAIN=console.example.com
VEILBIRD_API_DOMAIN=api.example.com
VEILBIRD_ADMIN_EMAIL=owner@example.com
VEILBIRD_ADMIN_PASSWORD=replace-with-a-long-random-password
# 32 random bytes, encoded as base64. Generate with: openssl rand -base64 32
VEILBIRD_MASTER_KEY=replace-with-32-byte-base64-key
VEILBIRD_PUBLIC_ORIGIN=https://app.example.com
VEILBIRD_API_ORIGIN=https://api.example.com
VEILBIRD_AGENT_ORIGIN=https://api.example.com

# Optional fallback for NEW REALITY nodes; a verified setting in Admin takes priority.
# Use a separate static HTTPS site, never the APP/Console/API domain.
VEILBIRD_REALITY_TARGET=

# Optional Controller map location. If unset, configure it from the Controller page.
VEILBIRD_CONTROLLER_LOCATION=
VEILBIRD_CONTROLLER_LATITUDE=
VEILBIRD_CONTROLLER_LONGITUDE=

# A random password for the PostgreSQL service. The one-click installer generates it.
VEILBIRD_DB_PASSWORD=replace-with-random-database-password

# Optional.
VEILBIRD_ADMIN_NAME=Owner
VEILBIRD_SESSION_TTL_SECONDS=43200

# TrackNothing app sign-in for every active account (device limits come from plans in Console → 套餐). Set 0 to turn the apps off.
VEILBIRD_NATIVE_ACCESS_ENABLED=1
# Idle days before a native client must sign in again (sliding, 1-90).
VEILBIRD_NATIVE_SESSION_DAYS=30
# Legacy read-only release list. New releases are managed in Console → 客户端发布.
VEILBIRD_CLIENT_RELEASES_JSON=[]
# Lets CI / `npm run release:client` upload installers, register drafts and publish to beta (32+ random chars).
# Promoting to stable, withdrawing and minimum versions stay console-only. Leave empty to disable.
VEILBIRD_RELEASE_TOKEN=
# Installer storage: "local" (default: upload in Console, kept on the Controller's data volume and served via
# the Portal) or "s3" (Cloudflare R2, AWS S3, MinIO…; the bucket needs CORS allowing PUT from the Console origin).
# Registering an installer already hosted at a public HTTPS URL works in both modes. "external" = "local".
VEILBIRD_RELEASE_STORAGE=local
# VEILBIRD_RELEASE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# VEILBIRD_RELEASE_S3_BUCKET=veilbird-downloads
# VEILBIRD_RELEASE_S3_REGION=auto
# VEILBIRD_RELEASE_S3_ACCESS_KEY_ID=
# VEILBIRD_RELEASE_S3_SECRET_ACCESS_KEY=
# Public (CDN) origin serving the same bucket, e.g. a custom domain bound to R2.
# VEILBIRD_RELEASE_PUBLIC_BASE_URL=https://downloads.example.com
# Optional download CDN for installers kept on the Controller (local storage): each uploaded build is
# copied to this S3-compatible bucket (Aliyun OSS, Cloudflare R2, ...) and the apps download from the CDN
# first, falling back to the Controller. Aliyun OSS: endpoint of the bucket region, region id such as
# cn-hangzhou; the RAM user needs oss:PutObject on the bucket; the CDN domain needs HTTPS and Range back-to-origin.
# VEILBIRD_RELEASE_MIRROR_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# VEILBIRD_RELEASE_MIRROR_REGION=cn-hangzhou
# VEILBIRD_RELEASE_MIRROR_BUCKET=tracknothing-downloads
# VEILBIRD_RELEASE_MIRROR_ACCESS_KEY_ID=
# VEILBIRD_RELEASE_MIRROR_SECRET_ACCESS_KEY=
# VEILBIRD_RELEASE_MIRROR_PUBLIC_BASE_URL=https://dl.example.com
# VEILBIRD_RELEASE_MIRROR_ADDRESSING=virtual   # virtual (default for aliyuncs.com) or path
# Disk housekeeping. Each update writes a database dump to ./backups; only the newest N are kept (0 = keep all).
VEILBIRD_BACKUP_KEEP=10
# After a healthy deploy, remove untagged old images and build cache older than 7 days. Set to "no" to skip.
VEILBIRD_DOCKER_PRUNE=yes
# Server images built by CI (.github/workflows/server-images.yml). Set to pull them instead of building on this
# host, e.g. ghcr.io/cntwdev/tracknothing or the Aliyun ACR prefix; a private registry needs one "docker login".
# VEILBIRD_IMAGE_PREFIX=ghcr.io/cntwdev/tracknothing
# Request limits. The Controller answers floods and repeated failed sign-ins with 429 (a failing address is
# blocked for 1 hour); "off" disables that. Each deploy also writes Nginx limits for this deployment's
# hostnames (scripts/setup-nginx-limits.sh); "no" skips it, e.g. behind a CDN where every visitor shares its IPs.
# VEILBIRD_RATE_LIMIT=on
# VEILBIRD_NGINX_LIMITS=yes
