FROM node:22-bookworm-slim AS dependencies
# Quiet build output: no "new npm major" notice, funding or audit summaries.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY public/favicon.svg ./public/favicon.svg
COPY scripts/check-frontend-assets.mjs scripts/compress-frontend-assets.mjs ./scripts/
COPY shared ./shared

FROM dependencies AS portal-build
COPY portal-web ./portal-web
RUN npm run build:portal

FROM dependencies AS admin-build
COPY admin-web ./admin-web
RUN npm run build:admin-web

FROM node:22-bookworm-slim AS portal-runtime
ENV NODE_ENV=production
ARG PORT=3100
ENV PORT=$PORT
WORKDIR /app
COPY --from=portal-build /app/dist/portal-web ./dist
COPY frontend-server.mjs ./frontend-server.mjs
USER node
EXPOSE $PORT
CMD ["node", "frontend-server.mjs"]

FROM node:22-bookworm-slim AS admin-runtime
ENV NODE_ENV=production
ARG PORT=3200
ENV PORT=$PORT
WORKDIR /app
COPY --from=admin-build /app/dist/admin-web ./dist
COPY frontend-server.mjs ./frontend-server.mjs
USER node
EXPOSE $PORT
CMD ["node", "frontend-server.mjs"]
