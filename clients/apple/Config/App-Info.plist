<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's own keys; Xcode merges them into the Info.plist it generates. INFOPLIST_KEY_ build settings only carry
     keys Xcode knows, so custom ones live here, filled from build settings (project.yml). -->
<plist version="1.0">
<dict>
	<!-- The name macOS shows in its own prompts ("... would like to use a new network extension"); the bundle and
	     executable keep the technical name Veilbird. -->
	<key>CFBundleName</key>
	<string>TrackNothing</string>
	<!-- tracknothing://toggle and tracknothing://open: the Mac widgets and Control Center button (WidgetBridge.swift). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>TrackNothing</string>
			<key>CFBundleURLSchemes</key>
			<array><string>tracknothing</string></array>
		</dict>
	</array>
	<key>VeilbirdAPIOrigin</key>
	<string>$(VEILBIRD_API_ORIGIN)</string>
	<key>VeilbirdAppGroup</key>
	<string>$(VEILBIRD_APP_GROUP)</string>
	<key>VeilbirdKeychainGroup</key>
	<string>$(VEILBIRD_KEYCHAIN_GROUP)</string>
</dict>
</plist>
