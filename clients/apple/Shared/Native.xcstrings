    "activity_dns_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxied names are resolved by the location, so your local DNS never sees them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走加速的域名由节点解析，本机不会向本地 DNS 泄露这些查询。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена через VPN разрешает узел, локальный DNS их не видит."
          }
        }
      }
    },
