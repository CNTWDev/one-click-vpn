    "activity_local_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this device only, cleared when you disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只记在本机，断开后清空"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только на этом устройстве, стирается при отключении"
