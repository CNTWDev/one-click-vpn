      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to see this device's connections, top sites and DNS lookups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后，这里会显示这台设备的连接、排行和 DNS 记录。"
