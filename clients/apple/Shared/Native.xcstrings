    "reset_change_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll email a link to %1$@ to set a new password. It works for 1 hour. Afterwards, every device signs in again with the new password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会把修改密码的链接发到 %1$@，1 小时内有效。改完后，所有设备都需要用新密码重新登录。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправим на %1$@ ссылку для нового пароля. Она действует 1 час. После смены пароля на всех устройствах нужно войти заново."
          }
        }
      }
    },
