    "device_limit_reached_account_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device limit reached (single-server configs count too; the subscription does not). Revoke an old device in Account, or delete an unused config in the portal, and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备数已达账号上限（单节点配置也算在内，订阅不算）。请到「账号」解除一台旧设备，或在门户删除不用的配置后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит устройств (конфигурации для одного сервера тоже считаются, подписка — нет). Отзовите старое устройство в аккаунте или удалите ненужную конфигурацию на портале и повторите."
          }
        }
      }
    },
    "device_limit_reached_revoke_an_old_device_and_try": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device limit reached (single-server configs count too; the subscription does not). Revoke an old device in Account, or delete an unused config in the portal, and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备数已达账号上限（单节点配置也算在内，订阅不算）。请到「账号」解除一台旧设备，或在门户删除不用的配置后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит устройств (конфигурации для одного сервера тоже считаются, подписка — нет). Отзовите старое устройство в аккаунте или удалите ненужную конфигурацию на портале и повторите."
          }
        }
      }
    },
    "device_limit_reached_revoke_an_old_device_in_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device limit reached (single-server configs count too; the subscription does not). Revoke an old device in Account, or delete an unused config in the portal, and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备数已达账号上限（单节点配置也算在内，订阅不算）。请到「账号」解除一台旧设备，或在门户删除不用的配置后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит устройств (конфигурации для одного сервера тоже считаются, подписка — нет). Отзовите старое устройство в аккаунте или удалите ненужную конфигурацию на портале и повторите."
          }
        }
      }
