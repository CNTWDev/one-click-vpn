    "whats_new": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's new"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版更新"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что нового"
          }
        }
      }
    },
    "whats_new_notes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faster connecting: the first line that answers is used right away instead of waiting for blocked ones to time out, and automatic location no longer waits for nodes that do not answer\nSmart routing no longer holds the first connection until its rules are downloaded: you connect at once and the rules apply when they arrive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接更快：哪条线路先通就先用，不再等被屏蔽的线路超时；自动选择位置时不再等不通的节点\n智能分流第一次连接不再等规则下载完，先连上，规则在后台下载好后自动生效"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение быстрее: используется первая ответившая линия, без ожидания заблокированных, а автовыбор локации больше не ждёт неотвечающие узлы\nУмная маршрутизация больше не задерживает первое подключение до загрузки правил: подключение сразу, правила применятся после загрузки"
          }
        }
      }
    },
