{
  "sourceLanguage": "en",
  "strings": {
    "a_location_is_selected_automatically_allow_the_system_vpn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A location is selected automatically. Allow the system VPN permission on your first connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认自动选择可用节点。第一次连接需要允许系统 VPN 权限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локация выбирается автоматически. При первом подключении разрешите использование VPN."
          }
        }
      }
    },
    "access_for_this_device_has_been_revoked_contact_your": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access for this device has been revoked. Contact your administrator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备的授权已解除，请联系管理员。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ устройства отозван. Обратитесь к администратору."
          }
        }
      }
    },
