    "allow_system_extension": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS needs you to allow the TrackNothing network extension before it can connect. Choose Open System Settings and turn TrackNothing on under General › Login Items & Extensions › Network Extensions (macOS 14 and earlier: Privacy & Security). It connects as soon as you allow it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要你允许 TrackNothing 的网络扩展才能连接。点「打开系统设置」，在「通用 › 登录项与扩展 › 网络扩展」（macOS 14 及更早：「隐私与安全性」）里打开 TrackNothing，允许后会自动连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS должна разрешить сетевое расширение TrackNothing, иначе подключиться нельзя. Нажмите «Открыть Системные настройки» и включите TrackNothing в разделе «Основные › Объекты входа и расширения › Сетевые расширения» (macOS 14 и раньше: «Конфиденциальность и безопасность»). Подключение начнётся сразу после разрешения."
          }
        }
      }
    },
    "allow_system_extension_short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the TrackNothing network extension in System Settings; it connects once allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置里允许 TrackNothing 的网络扩展，允许后自动连接"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите сетевое расширение TrackNothing в Системных настройках; подключение начнётся само"
          }
        }
      }
    },
    "allow_the_system_to_add_a_vpn_on_first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the system to add a VPN on first connection. Manage authorized devices in Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接时，请允许系统添加 VPN。授权设备可在「我的」中管理。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом подключении разрешите добавление VPN. Управляйте устройствами в аккаунте."
          }
        }
      }
    },
    "allow_the_system_vpn_permission_to_connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackNothing needs your permission to set up a VPN. Choose Try again and tap OK in the system prompt. If no prompt appears, another VPN app may be set to Always-on; turn that off in Settings › VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要允许 TrackNothing 建立 VPN 连接。点「重试」，在系统弹窗里选「确定」。如果没有弹窗，可能是其他 VPN 应用设置了「始终开启」，请到系统设置 › VPN 里关掉它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TrackNothing нужно разрешение на VPN. Нажмите «Повторить» и выберите «ОК» в системном окне. Если окно не появляется, возможно, у другого VPN-приложения включён «Постоянный VPN»; отключите его в Настройках › VPN."
          }
        }
      }
    },
