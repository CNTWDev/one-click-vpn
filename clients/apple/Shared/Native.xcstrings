        }
      }
    },
    "activity_no_apps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system VPN cannot see which app opened a connection, so this ranks by rule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统 VPN 看不到是哪个应用发起的连接，所以按规则统计。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный VPN не видит, какое приложение открыло соединение, поэтому топ по правилам."
          }
        }
      }
    },
