    "allow_the_system_to_add_a_vpn_on_first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the system to add a VPN on first connection. Manage authorized devices in Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接时，请允许系统添加 VPN。授权设备可在「我的」中管理。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом подключении разрешите добавление VPN. Управляйте устройствами в аккаунте."
          }
        }
      }
    },
    "allow_the_system_vpn_permission_to_connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the system VPN permission to connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许系统 VPN 权限后才能连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для подключения разрешите использование VPN."
          }
        }
      }
    },
    "allow_vpn_access_on_your_first_connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
