<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF types stay the defaults. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <RootNamespace>Veilbird</RootNamespace>
    <NeutralLanguage>en</NeutralLanguage>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Veilbird</AssemblyName>
    <Product>TrackNothing</Product>
    <AssemblyTitle>TrackNothing</AssemblyTitle>
    <ApplicationIcon>Assets\Veilbird.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Veilbird.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\Veilbird.ico" /><Resource Include="Assets\Fonts\Doto-Black.ttf" /></ItemGroup>
  <!-- veilbird-core.exe (the embedded mihomo core, clients/core) comes from build.ps1. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\.deps\$(RuntimeIdentifier)\veilbird-core.exe')">
    <None Include="..\.deps\$(RuntimeIdentifier)\veilbird-core.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="veilbird-core.exe" />
  </ItemGroup>
  <!-- Release builds bake the service address in (environment variable VEILBIRD_API_ORIGIN, the GitHub variable of the
       same name), so users only sign in; without it (development builds) the sign-in page asks for one. -->
  <ItemGroup><AssemblyMetadata Include="VeilbirdApiOrigin" Value="$(VEILBIRD_API_ORIGIN)" /></ItemGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" /></ItemGroup>
</Project>
