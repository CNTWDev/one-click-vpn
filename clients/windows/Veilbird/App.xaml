<Application x:Class="Veilbird.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <!-- The one dark palette of the app (lime on near-black green), the same values as on the phones and the Mac. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Ground" Color="#0D1310"/>
    <SolidColorBrush x:Key="Surface" Color="#151C17"/>
    <SolidColorBrush x:Key="Raised" Color="#1F2922"/>
    <SolidColorBrush x:Key="Selected" Color="#263127"/>
    <SolidColorBrush x:Key="Text" Color="#ECF1E8"/>
    <SolidColorBrush x:Key="Secondary" Color="#93A090"/>
    <SolidColorBrush x:Key="Faint" Color="#7F8B7C"/>
    <SolidColorBrush x:Key="Accent" Color="#B7DC68"/>
    <SolidColorBrush x:Key="OnAccent" Color="#111912"/>
    <SolidColorBrush x:Key="Danger" Color="#F0907A"/>
    <SolidColorBrush x:Key="Hover" Color="#0FECF1E8"/>
    <SolidColorBrush x:Key="Pressed" Color="#08ECF1E8"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <!-- Default buttons are quiet rows and tiles: no fill of their own, a faint wash on hover. -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="14,0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <Border x:Name="Wash" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Background" Value="{StaticResource Hover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="Background" Value="{StaticResource Pressed}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Wash" Property="Background" Value="{StaticResource Hover}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Draws only its content: the connect ring and the title bar's own buttons. -->
    <Style x:Key="Bare" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- On/off switch, 40 by 20. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="Transparent" BorderBrush="{StaticResource Secondary}" BorderThickness="1" Padding="3">
          <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource Secondary}" HorizontalAlignment="Left"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Track" Property="BorderThickness" Value="0"/><Setter TargetName="Track" Property="Padding" Value="4"/>
            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource OnAccent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="#2EECF1E8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Field" Property="BorderThickness" Value="0,0,0,2"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="#2EECF1E8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Field" Property="BorderThickness" Value="0,0,0,2"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- A thin dark scroll bar that does not compete with the content. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#33ECF1E8" CornerRadius="3" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
