<Window x:Class="Veilbird.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TrackNothing" Icon="Assets/Veilbird.ico" Width="380" Height="672" ResizeMode="CanMinimize" WindowStyle="None" Background="{StaticResource Ground}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">
  <!-- A small fixed-size tool window with its own dark title bar; the tray icon carries the quick actions. -->
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border BorderBrush="#1FECF1E8" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="44"/><RowDefinition Height="2"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Bare}" Width="46" Height="32" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick">
          <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="10"/>
        </Button>
        <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource Bare}" Width="46" Height="32" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick">
          <TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="10"/>
        </Button>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <ContentControl x:Name="TitleLogo" Width="16" Height="16" Margin="0,0,8,0"/>
          <TextBlock Text="TRACKNOTHING" FontFamily="{StaticResource Dots}" FontSize="13" VerticalAlignment="Center" AutomationProperties.Name="TrackNothing"/>
        </StackPanel>
      </DockPanel>
      <!-- Pages switch with text tabs and a short lime underline; the right side holds the page's one action. -->
      <DockPanel Grid.Row="1" Margin="16,0,12,0" LastChildFill="False">
        <StackPanel x:Name="NavigationPanel" DockPanel.Dock="Left" Orientation="Horizontal"/>
        <ContentControl x:Name="HeaderSlot" DockPanel.Dock="Right" VerticalAlignment="Center"/>
      </DockPanel>
      <ProgressBar x:Name="BusyBar" Grid.Row="2" Height="2" Margin="16,0" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0" Visibility="Hidden"/>
      <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel x:Name="ContentPanel" Margin="16,8,16,16"/></ScrollViewer>
      <Grid x:Name="FullPanel" Grid.Row="3" Visibility="Collapsed"/>
      <Border x:Name="Toast" Grid.Row="3" VerticalAlignment="Bottom" Margin="16,0,16,16" Padding="14,10" CornerRadius="8" Background="{StaticResource Raised}" BorderBrush="#66F0907A" BorderThickness="1" Visibility="Collapsed" Cursor="Hand">
        <TextBlock x:Name="ToastText" FontSize="13"/>
      </Border>
    </Grid>
  </Border>
</Window>
