<Window x:Class="Veilbird.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TrackNothing" Icon="Assets/Veilbird.ico" Width="380" Height="640" ResizeMode="CanMinimize" Background="#F8F6EE" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
  <!-- A small fixed-size tool window; the tray icon carries the quick actions. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="20,14,20,4" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="TrackNothing" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock x:Name="HeaderAction" DockPanel.Dock="Right" Foreground="#007A64" Cursor="Hand" VerticalAlignment="Center" Padding="8,6"/>
    </DockPanel>
    <ProgressBar x:Name="BusyBar" Grid.Row="1" Height="3" Margin="20,2,20,2" IsIndeterminate="True" Foreground="#007A64" Background="Transparent" BorderThickness="0" Visibility="Hidden"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ContentPanel" Margin="20,6,20,16"/></ScrollViewer>
    <Border Grid.Row="3" Background="White" Padding="10,8"><UniformGrid x:Name="NavigationPanel" Rows="1"/></Border>
  </Grid>
</Window>
