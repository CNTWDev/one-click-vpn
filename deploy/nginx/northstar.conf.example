# Northstar has three independently deployable HTTP surfaces:
#   controller-api :3000, portal-web :3100, admin-web :3200
# Replace the hostnames and certificate paths before enabling.

upstream northstar_controller { server 127.0.0.1:3000; keepalive 32; }
upstream northstar_portal { server 127.0.0.1:3100; keepalive 16; }
upstream northstar_admin { server 127.0.0.1:3200; keepalive 16; }

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com console.example.com api.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.example.com;

    ssl_certificate     /etc/nginx/ssl/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/app.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;

    # Portal proxies /api to http://northstar:3000 over the Docker network.
    location / { proxy_pass http://northstar_portal; include /etc/nginx/snippets/northstar-proxy.conf; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name console.example.com;

    ssl_certificate     /etc/nginx/ssl/console.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/console.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;

    # Admin proxies /api to http://northstar:3000 over the Docker network.
    location / { proxy_pass http://northstar_admin; include /etc/nginx/snippets/northstar-proxy.conf; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.example.com;

    ssl_certificate     /etc/nginx/ssl/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://northstar_controller;
        include /etc/nginx/snippets/northstar-proxy.conf;
    }
}
