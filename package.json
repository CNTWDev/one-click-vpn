{
  "name": "veilbird-control-plane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run i18n:check && npm run build:controller && npm run build:portal && npm run build:admin-web",
    "build:controller": "next build --webpack",
    "build:portal": "vite build --config portal-web/vite.config.ts && node scripts/check-frontend-assets.mjs portal-web && node scripts/compress-frontend-assets.mjs portal-web",
    "build:admin-web": "vite build --config admin-web/vite.config.ts && node scripts/check-frontend-assets.mjs admin-web && node scripts/compress-frontend-assets.mjs admin-web",
    "dev:portal": "vite --config portal-web/vite.config.ts",
    "dev:admin-web": "vite --config admin-web/vite.config.ts",
    "start": "next start",
    "deploy": "./scripts/deploy.sh",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p admin-web && tsc --noEmit -p portal-web",
    "db:migrate": "node scripts/migrate.mjs",
    "i18n:generate": "node scripts/native-locales.mjs",
    "i18n:check": "node scripts/native-locales.mjs --check && node --test tests/portal-i18n.test.mjs tests/product-i18n.test.mjs",
    "clients:doctor": "node scripts/clients.mjs doctor",
    "clients:build": "node scripts/clients.mjs build",
    "release:client": "node scripts/release-client.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.5",
    "next": "16.2.6",
    "nodemailer": "^8.0.11",
    "pg": "^8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
